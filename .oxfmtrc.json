{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "backend/**",
    "data/**",
    "migrations/**",
    ".venv/**",
    "node_modules/**",
    "dist/**",
    "runtime/**",
    "test-results/**",
    "playwright-report/**",
    "bun.lock",
    "*.tsbuildinfo",
    "public/*.svg"
  ]
}
