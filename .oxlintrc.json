{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "rules": { "eslint/no-unused-vars": "error" },
  "env": { "browser": true, "node": true },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".venv/**",
    "runtime/**",
    "test-results/**",
    "playwright-report/**"
  ]
}
